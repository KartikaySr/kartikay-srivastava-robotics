function(rl_add_desktop_resources target)
    if(Qt6_FOUND)
        qt6_add_resources(resources ${rl_SOURCE_DIR}/desktop/branding.qrc)
    elseif(Qt5_FOUND)
        qt5_add_resources(resources ${rl_SOURCE_DIR}/desktop/branding.qrc)
    else()
        qt4_add_resources(resources ${rl_SOURCE_DIR}/desktop/branding.qrc)
    endif()
    target_compile_definitions(${target} PRIVATE RL_DESKTOP_EXAMPLES="${rl_SOURCE_DIR}/examples")
    target_sources(${target} PRIVATE ${resources})
    target_include_directories(${target} PRIVATE ${rl_SOURCE_DIR}/desktop ${rl_BINARY_DIR}/src)
endfunction()
